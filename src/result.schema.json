{
  "type": "object",
  "properties": {
    "outcome": { "type": "string", "enum": ["ok", "question", "revise", "error", "partial", "permission"] },
    "summary": { "type": "string" },
    "question": { "type": "string" },
    "permission": {
      "type": "object",
      "properties": { "network": { "type": "boolean" }, "paths": { "type": "array", "items": { "type": "string" } } },
      "required": ["network", "paths"],
      "additionalProperties": false
    },
    "decisions": {
      "type": "object",
      "properties": {
        "requirements": { "type": "string" },
        "granularity": { "type": "string" },
        "architecture": { "type": "string" }
      },
      "required": ["requirements", "granularity", "architecture"],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "title": { "type": "string" }, "acceptance": { "type": "string" } },
        "required": ["title", "acceptance"],
        "additionalProperties": false
      }
    }
  },
  "required": ["outcome", "summary", "question", "permission", "decisions", "tasks"],
  "additionalProperties": false
}
