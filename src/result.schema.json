{
  "type": "object",
  "properties": {
    "returnTo": { "type": "string", "enum": ["execute", "prereview", "none"] },
    "outcome": { "type": "string", "enum": ["ok", "question", "revise", "error", "partial", "permission", "approval", "replan"] },
    "summary": { "type": "string" },
    "question": { "type": "string" },
    "permission": {
      "type": "object",
      "properties": { "network": { "type": "boolean" }, "paths": { "type": "array", "items": { "type": "string" } } },
      "required": ["network", "paths"],
      "additionalProperties": false
    },
    "decisions": {
      "type": "object",
      "properties": {
        "requirements": { "type": "string" },
        "granularity": { "type": "string" },
        "architecture": { "type": "string" }
      },
      "required": ["requirements", "granularity", "architecture"],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "verification": { "type": "string", "minLength": 1 },
        "remaining": { "type": "string", "minLength": 1 }
      },
      "required": ["scope", "decisions", "verification", "remaining"],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "title": { "type": "string" }, "acceptance": { "type": "string" } },
        "required": ["title", "acceptance"],
        "additionalProperties": false
      }
    }
  },
  "required": ["returnTo", "outcome", "summary", "question", "permission", "decisions", "tasks", "report"],
  "additionalProperties": false
}
