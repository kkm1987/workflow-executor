{
  "type": "object",
  "properties": {
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tasks": { "type": "string" },
          "action": { "type": "string" },
          "limits": { "type": "string" },
          "stopWhen": { "type": "string" },
          "gate": { "type": "string", "enum": ["plan", "each"] },
          "scripts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "effect": { "type": "string", "enum": ["read", "write", "external"] },
          "costCheck": { "type": "string" },
          "grants": {
            "type": "object",
            "properties": {
              "network": { "type": "boolean" },
              "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "required": ["network", "paths"],
            "additionalProperties": false
          },
          "replaces": { "type": "string" },
          "basisAnswer": { "type": "integer", "minimum": 0 }
        },
        "required": ["tasks", "action", "limits", "stopWhen", "gate", "scripts", "files", "effect", "costCheck", "grants", "replaces", "basisAnswer"],
        "additionalProperties": false
      }
    },
    "retainedApprovals": { "type": "array", "items": { "type": "string" } },
    "returnTo": { "type": "string", "enum": ["execute", "prereview", "none"] },
    "outcome": { "type": "string", "enum": ["ok", "question", "error"] },
    "summary": { "type": "string" },
    "question": { "type": "string" },
    "change": { "type": "string" },
    "decisions": {
      "type": "object",
      "properties": {
        "selection": { "type": "string" },
        "applicability": { "type": "string" },
        "updates": { "type": "string" },
        "granularity": { "type": "string" }
      },
      "required": ["selection", "applicability", "updates", "granularity"],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "verification": { "type": "string", "minLength": 1 },
        "remaining": { "type": "string", "minLength": 1 }
      },
      "required": ["scope", "decisions", "verification", "remaining"],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "title": { "type": "string" }, "acceptance": { "type": "string" } },
        "required": ["title", "acceptance"],
        "additionalProperties": false
      }
    }
  },
  "required": ["returnTo", "outcome", "summary", "question", "change", "decisions", "tasks", "report", "approvals", "retainedApprovals"],
  "additionalProperties": false
}
