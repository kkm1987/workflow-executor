{
  "type": "object",
  "properties": {
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tasks": { "type": "string" },
          "action": { "type": "string" },
          "limits": { "type": "string" },
          "stopWhen": { "type": "string" }
        },
        "required": ["tasks", "action", "limits", "stopWhen"],
        "additionalProperties": false
      }
    },
    "outcome": { "type": "string", "enum": ["ok", "question", "error"] },
    "summary": { "type": "string" },
    "question": { "type": "string" },
    "change": { "type": "string" },
    "decisions": {
      "type": "object",
      "properties": {
        "selection": { "type": "string" },
        "applicability": { "type": "string" },
        "updates": { "type": "string" }
      },
      "required": ["selection", "applicability", "updates"],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "verification": { "type": "string", "minLength": 1 },
        "remaining": { "type": "string", "minLength": 1 }
      },
      "required": ["scope", "decisions", "verification", "remaining"],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "title": { "type": "string" }, "acceptance": { "type": "string" } },
        "required": ["title", "acceptance"],
        "additionalProperties": false
      }
    }
  },
  "required": ["outcome", "summary", "question", "change", "decisions", "tasks", "report", "approvals"],
  "additionalProperties": false
}
